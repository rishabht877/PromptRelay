{
  "uid": "promptrelay-overview",
  "title": "PromptRelay — Overview",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/sec by provider & cache",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider, cache) (rate(promptrelay_requests_total[5m]))",
          "legendFormat": "{{provider}} / {{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p99 (s) by provider",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(promptrelay_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{provider}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(promptrelay_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens/sec by model & type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model, type) (rate(promptrelay_tokens_total[5m]))",
          "legendFormat": "{{model}} / {{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Estimated cost (USD, cumulative) by model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (promptrelay_cost_usd_total)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(promptrelay_cache_lookups_total{result=~\"exact_hit|semantic_hit\"}[5m])) / clamp_min(sum(rate(promptrelay_cache_lookups_total[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider fallbacks/sec by reason",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(promptrelay_fallbacks_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
